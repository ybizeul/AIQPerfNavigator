{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["bun"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.d.ts"],
  // Bun supplies the real `process` typing here, so the app's narrow stub conflicts.
  "exclude": ["src/process-env.d.ts"]
}
