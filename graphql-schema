  Open-standard protocol for network-based backup for Network Attached Storage (NAS).
  """
  NDMP

  """
  NetApp SnapCenter Software is a unified, scalable platform for data protection.
  """
  SNAPCENTER

  """Disk-based storage backup feature of Data ONTAP."""
  SNAPVAULT

  """
  Feature of Data ONTAP that enables you to replicate data from specified source volumes or qtrees to specified destination volumes or qtrees, respectively.
  """
  SNAPMIRROR
}

"""Volume file count attributes"""
type VolumeFiles {
  """The maximum number of files that the ONTAP volume can support."""
  total: Float!

  """
  The total count of files stored on the volume includes all user-visible file system elements, such as directories, regular files, streams, ACLs.
  """
  used: Float!
}

"""Logical Volume Capacity"""
type VolumeLogicalCapacity {
  """
  Total logical storage used capacity. Logical space used is physical space (bits written to disk) used plus all other storage as it appears (including space saved from storage efficiencies and that consumed by snapshots and FlexClone overheads).
  """
  usedKiB: Float

  """
  The total Volume Virtual Block Numbers(VVBNs) used in kibibytes. This capacity metric was introduced in ONTAP version 9.14.1.
  """
  virtualKiB: Float

  """
  The amount of inactive user data stored in the performance tier that could be tiered out to a cloud tier if the volume is in a FabricPool and for which the auto tiering policy has been specified.
  """
  perfTierInactiveUserDataKiB: Float

  """
  The space occupied by actual data on a volume, plus space reserved for snapshot copies.
  """
  usedWithReserveKiB: Float

  """
  The component of logical storage representing just the apparent capacity of the snapshots.
  """
  usedSnapshotsKiB: Float
}

"""Volume performance"""
type VolumePerformance {
  """
  Maximum value of the hourly average of the IOPS over a period of 30 days.
  """
  iops: Float

  """Average latency in milliseconds over a period of 30 days."""
  averageLatencyMs: Float
}

"""Volume Protocol"""
enum VolumeProtocol {
  NFS
  CIFS
  SMB
  FCP
  ISCSI
  UNDETERMINED
}

"""Volume provisioning attributes"""
type VolumeProvisioning {
  """
  Indicates whether thin provisioning is enabled for the volume. If space guarantee is set to 'none', this is always true. If set to 'volume', this will be false.
  """
  isThinProvisioned: Boolean!

  """
  Represents the classification of a volume based on its specific attributes or intended use.
  """
  type: VolumeType!

  """
  Refers to the structure and scalability of the volume. There are two main volume styles: flexible volumes (flex) and Infinite Volumes (infinitevol).
  """
  style: VolumeStyle!

  """
  Extended volume style - provides information about the volumes that are configured with the specified extended style.
  """
  extendedStyle: ExtendedVolumeStyle!

  """
  The character set used to display and store file and directory names within a volume.
  """
  language: String
}

"""Volume provisioning attributes for filtering"""
input VolumeProvisioningInput {
  """
  Indicates whether thin provisioning is enabled for the volume. If space guarantee is set to 'none', this is always true. If set to 'volume', this will be false.
  """
  isThinProvisioned: Boolean

  """
  Represents the classification of a volume based on its specific attributes or intended use.
  """
  types: [VolumeType!]

  """
  Refers to the structure and scalability of the volume. There are two main volume styles: flexible volumes (flex) and Infinite Volumes (infinitevol).
  """
  styles: [VolumeStyle!]

  """
  Extended volume style - provides information about the volumes that are configured with the specified extended style.
  """
  extendedStyles: [ExtendedVolumeStyle!]

  """
  The character set used to display and store file and directory names within a volume.
  """
  language: String
}

"""Volume recommendation"""
type VolumeRecommendation {
  """Volume recommendation type"""
  recommendationType: VolumeRecommendationType!

  """Indicates whether a volume is ready for cloud migration."""
  isCloudReady: Boolean!

  """
  Estimated accuracy of the recommendation on install base, takes values 0-1, the results when sent are sorted by descending order of confidence
  """
  confidence: Float!

  """Recommendation feature"""
  destination: RecommendedFeature

  """
  Array of existing solutions where the volume is backed up, replicated, etc.
  """
  existingSolutions: [VolumeExistingSolution!]
}

"""Volume Recommendation Type"""
enum VolumeRecommendationType {
  DISASTER_RECOVERY
  BACKUP
  TIERING
  VOLUME_MIGRATION
}

"""
A list of volumes and a cursor. Pass the cursor to the volumes query to fetch the next set of results
"""
type Volumes {
  """Total number of volumes."""
  totalCount: Float!

  """
  Cursor of last element returned. Pass this to subsequent query to fetch the next set of results.
  """
  cursor: String!

  """List of volumes. (Not supported on ASA R2 systems.)"""
  volumes: [Volume!]!
}

"""Sort by field name."""
enum VolumeSortByFields {
  """Sort by Used Capacity Percentage"""
  USED_CAPACITY_PERCENTAGE

  """Sort by IOPS"""
  IOPS
}

"""Specifies the attribute of volume by which data is ordered."""
input VolumeSortCriteria {
  """Sort field of the results based on which sorting is to be done."""
  orderBy: VolumeSortByFields!

  """Sort order of the results in terms of ascending or descending."""
  order: SortOrder! = ASC
}

"""Volumes summary"""
type VolumesSummary {
  """Count of volumes."""
  volumeCount: Int

  """Total capacity of the volumes."""
  totalCapacity: VolumeCapacity
}

"""State of the volume."""
enum VolumeState {
  """The volume is available for read and write operations."""
  ONLINE

  """The volume is not available for any operations."""
  OFFLINE

  """
  The volume is not available for client access but can be accessed for administrative operations.
  """
  RESTRICTED

  """Forces the volume to be online."""
  FORCE_ONLINE

  """Forces the volume to be offline."""
  FORCE_OFFLINE

  """Applies only to FlexGroup volumes and cannot be set as a target state."""
  MIXED
}

"""Style of the volume."""
enum VolumeStyle {
  """
  Traditional flexible volume style that provides the foundation for ONTAP storage management.
  """
  FLEX

  """
  An Infinite Volume is a single, scalable volume designed to store large amounts of data across multiple aggregates. No longer supported from ONTAP 9.5
  """
  INFINITEVOL
}

"""Type of the volume."""
enum VolumeType {
  """Load Sharing"""
  LS

  """Data Protection"""
  DP

  """Read/Write"""
  RW

  """Deleted"""
  DEL

  """Data Copy"""
  DC

  """Temporary"""
  TMP

  """Unknown or Not Applicable"""
  UNKNOWN
}

"""vServer details"""
type Vserver {
  """vServer identifier"""
  id: String!

  """vServer name"""
  name: String!

  """vServer type"""
  type: StorageVirtualMachineType!

  """vServer sub type"""
  subType: String

  """
  List of logical interfaces (LIFs) owned by this Storage Virtual Machine(vserver).
  """
  logicalInterfaces: [LogicalInterface!]!
}

"""Workload"""
type Workload {
  """Workload name"""
  name: String!
}

"""Workload Category"""
enum WorkloadCategory {
  CLOUD_READY
}

"""Field to workload group by."""
enum WorkloadGroupBy {
  """To get volume, system and total capacity by workload name"""
  WORKLOAD

  """To get volume, system and total capacity by protocol name"""
  VOLUME_PROTOCOL

  """To get volume, system and total capacity by system serial number"""
  SYSTEM
}

"""
This is a count of workloads for each of the possible values of the GroupBy field.
"""
type WorkloadSummary {
  """Value of the groupBy field"""
  name: String

  """Count of systems."""
  systemCount: Int

  """Count of volumes."""
  volumeCount: Int

  """Total capacity of the volumes. (Not supported on ASA R2 systems.)"""
  totalCapacity: VolumeCapacity

  """Applies groupBy field to workload group"""
  groupBy(
    """Workload group key"""
    groupBy: WorkloadGroupBy!
  ): [WorkloadSummary!]

  """The amount of data that has been moved to another tier."""
  totalTieredKB: Float

  """The amount of data which are not monitored"""
  totalUnmonitoredKB: Float!
}

"""Workload Tags"""
type WorkloadTags {
  """
  ONTAP automatically detects and assigns a workload tag based on the I/O pattern, protocol usage, and client type.
  """
  autoTags: [String!]!

  """
  The workload tag is explicitly set by an administrator using ONTAP CLI, System Manager, or REST API.
  """
  ontapTags: [String!]!
}